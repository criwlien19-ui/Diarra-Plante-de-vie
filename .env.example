# ============================================================
# DIARRA PLANTE DE VIE — Variables d'environnement requises
# ============================================================
# Copiez ce fichier en .env.local pour le développement local
# Configurez ces variables dans Vercel Dashboard pour la production
# ⚠️ Ne jamais commiter .env.local dans git

# --- Supabase ---
# Trouvez ces valeurs dans : Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=votre_anon_key_publique_ici

# --- Google Gemini AI ---
# Créez/renouvelez votre clé sur : https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=votre_clé_gemini_ici

# --- Administration ---
# Mot de passe de l'espace admin (/admin)
# Choisissez un mot de passe fort (min. 12 caractères, maj/min/chiffres/symboles)
VITE_ADMIN_USERNAME=Admin
VITE_ADMIN_PASSWORD=ChoisissezUnMotDePasseFort!123

# --- Contact (optionnel - centralise les infos de contact) ---
# Numéro WhatsApp sans espaces ni '+' (ex: 33749718309 pour +33 7 49 71 83 09)
VITE_WHATSAPP_NUMBER=33749718309
VITE_CONTACT_EMAIL=Senpixelstudio@gmail.com
